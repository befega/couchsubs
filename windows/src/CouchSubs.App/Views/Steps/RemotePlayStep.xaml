<!-- Görüntü bu bilgisayardaki Remote Play penceresinden okunurken: hangi uygulamanın penceresi okunacak, kurulu mu. -->
<UserControl x:Class="CouchSubs.App.Views.Steps.RemotePlayStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:s="clr-namespace:CouchSubs.App.Views.Steps"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout Title="{t:T 'Remote Play on this PC'}"
                  Message="{t:T 'CouchSubs reads the subtitles from PS Remote Play or chiaki-ng on this PC. No second account or PS5 pairing is needed. You can connect a TV later.'}">
        <c:Card>
            <s:RemotePlaySetup />
        </c:Card>
    </c:StepLayout>
</UserControl>
