<!-- Görüntü seçilen pencereden okunurken: hangi pencere. Pencere henüz açık değilse adım geçilebilir; sonra Ayarlar'da seçilir. -->
<UserControl x:Class="CouchSubs.App.Views.Steps.CaptureWindowStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:s="clr-namespace:CouchSubs.App.Views.Steps"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout Title="{t:T 'Choose the capture window'}"
                  Message="{t:T 'Choose the window that shows the game picture, for example an OBS projector or your capture card app. CouchSubs reads only that window.'}">
        <c:Card>
            <s:CaptureWindowSetup />
        </c:Card>
    </c:StepLayout>
</UserControl>
